  <data name="CalendarView_Name" xml:space="preserve">
    <value>Calendar View</value>
  </data>
  <data name="CalendarView_Desc" xml:space="preserve">
    <value>A Dataverse view as a month or week calendar, by a date column.</value>
  </data>
  <data name="Records_DataSet_Name" xml:space="preserve">
    <value>Records</value>
  </data>
  <data name="StartField_Name" xml:space="preserve">
    <value>Start</value>
  </data>
  <data name="StartField_Desc" xml:space="preserve">
    <value>The date column an event starts on. A Date Only column places whole days; a Date and Time column places times. Moving an event writes this column.</value>
  </data>
  <data name="EndField_Name" xml:space="preserve">
    <value>End</value>
  </data>
  <data name="EndField_Desc" xml:space="preserve">
    <value>Optional. The date column an event ends on, so it spans its days. Moved with the start.</value>
  </data>
  <data name="TitleField_Name" xml:space="preserve">
    <value>Title</value>
  </data>
  <data name="TitleField_Desc" xml:space="preserve">
    <value>The text column shown on each event.</value>
  </data>
  <data name="ColorField_Name" xml:space="preserve">
    <value>Colour</value>
  </data>
  <data name="ColorField_Desc" xml:space="preserve">
    <value>Optional. A choice column whose option colours colour the events; its label is shown as a badge in the week view.</value>
  </data>
  <data name="DefaultView_Name" xml:space="preserve">
    <value>Default view</value>
  </data>
  <data name="DefaultView_Desc" xml:space="preserve">
    <value>The view the calendar opens in: a month grid, a week, or a timeline with one row per event. The user can switch at any time.</value>
  </data>
  <data name="View_Month" xml:space="preserve">
    <value>Month</value>
  </data>
  <data name="View_Week" xml:space="preserve">
    <value>Week</value>
  </data>
  <data name="View_Timeline" xml:space="preserve">
    <value>Timeline</value>
  </data>
  <data name="WeekStart_Name" xml:space="preserve">
    <value>Week starts on</value>
  </data>
  <data name="WeekStart_Desc" xml:space="preserve">
    <value>Auto follows the user’s personal options. Set Sunday or Monday to fix it for everyone.</value>
  </data>
  <data name="WeekStart_Auto" xml:space="preserve">
    <value>Auto (user setting)</value>
  </data>
  <data name="WeekStart_Sunday" xml:space="preserve">
    <value>Sunday</value>
  </data>
  <data name="WeekStart_Monday" xml:space="preserve">
    <value>Monday</value>
  </data>
  <data name="InitialDate_Name" xml:space="preserve">
    <value>Opens on</value>
  </data>
  <data name="InitialDate_Desc" xml:space="preserve">
    <value>The day the calendar opens on, as yyyy-MM-dd. Leave empty for today.</value>
  </data>
  <data name="AllowMove_Name" xml:space="preserve">
    <value>Allow move</value>
  </data>
  <data name="AllowMove_Desc" xml:space="preserve">
    <value>Whether an event can be dragged, or moved from its menu, to another day. Needs a host that can write.</value>
  </data>
  <data name="AllowCreate_Name" xml:space="preserve">
    <value>Allow create</value>
  </data>
  <data name="AllowCreate_Desc" xml:space="preserve">
    <value>Whether each day offers a + that opens the quick create form with that day filled in. Model-driven apps only.</value>
  </data>
  <data name="OpenOnEventClick_Name" xml:space="preserve">
    <value>Open on click</value>
  </data>
  <data name="OpenOnEventClick_Desc" xml:space="preserve">
    <value>Whether clicking an event opens its record.</value>
  </data>
  <data name="ShowTimes_Name" xml:space="preserve">
    <value>Show times</value>
  </data>
  <data name="ShowTimes_Desc" xml:space="preserve">
    <value>Whether a timed event shows its start time in front of its title.</value>
  </data>
  <data name="PageSize_Name" xml:space="preserve">
    <value>Events per fetch</value>
  </data>
  <data name="PageSize_Desc" xml:space="preserve">
    <value>How many events load at once. Leave empty to use the host’s own page size. A month with more shows Load more.</value>
  </data>
  <data name="SelectedDate_Name" xml:space="preserve">
    <value>Selected date</value>
  </data>
  <data name="SelectedDate_Desc" xml:space="preserve">
    <value>The day last clicked or moved to, as yyyy-MM-dd.</value>
  </data>
  <data name="MovedRecordId_Name" xml:space="preserve">
    <value>Moved record</value>
  </data>
  <data name="MovedRecordId_Desc" xml:space="preserve">
