  <data name="CalendarView_Name" xml:space="preserve">
    <value>Vue calendrier</value>
  </data>
  <data name="CalendarView_Desc" xml:space="preserve">
    <value>Une vue Dataverse sous forme de calendrier mensuel ou hebdomadaire, selon une colonne de date.</value>
  </data>
  <data name="Records_DataSet_Name" xml:space="preserve">
    <value>Enregistrements</value>
  </data>
  <data name="StartField_Name" xml:space="preserve">
    <value>Début</value>
  </data>
  <data name="StartField_Desc" xml:space="preserve">
    <value>La colonne de date à laquelle un événement commence. Une colonne Date seule place des journées entières ; une colonne Date et heure place des heures. Déplacer un événement écrit cette colonne.</value>
  </data>
  <data name="EndField_Name" xml:space="preserve">
    <value>Fin</value>
  </data>
  <data name="EndField_Desc" xml:space="preserve">
    <value>Facultatif. La colonne de date à laquelle un événement se termine, pour qu’il couvre ses journées. Déplacée avec le début.</value>
  </data>
  <data name="TitleField_Name" xml:space="preserve">
    <value>Titre</value>
  </data>
  <data name="TitleField_Desc" xml:space="preserve">
    <value>La colonne de texte affichée sur chaque événement.</value>
  </data>
  <data name="ColorField_Name" xml:space="preserve">
    <value>Couleur</value>
  </data>
  <data name="ColorField_Desc" xml:space="preserve">
    <value>Facultatif. Une colonne de choix dont les couleurs d’option colorent les événements ; son libellé apparaît en badge dans la vue semaine.</value>
  </data>
  <data name="DefaultView_Name" xml:space="preserve">
    <value>Vue par défaut</value>
  </data>
  <data name="DefaultView_Desc" xml:space="preserve">
    <value>La vue dans laquelle le calendrier s’ouvre : une grille mensuelle, une semaine ou une chronologie avec une ligne par événement. L’utilisateur peut en changer à tout moment.</value>
  </data>
  <data name="View_Month" xml:space="preserve">
    <value>Mois</value>
  </data>
  <data name="View_Week" xml:space="preserve">
    <value>Semaine</value>
  </data>
  <data name="View_Timeline" xml:space="preserve">
    <value>Chronologie</value>
  </data>
  <data name="WeekStart_Name" xml:space="preserve">
    <value>Début de semaine</value>
  </data>
  <data name="WeekStart_Desc" xml:space="preserve">
    <value>Auto suit les options personnelles de l’utilisateur. Choisissez dimanche ou lundi pour l’imposer à tous.</value>
  </data>
  <data name="WeekStart_Auto" xml:space="preserve">
    <value>Auto (réglage utilisateur)</value>
  </data>
  <data name="WeekStart_Sunday" xml:space="preserve">
    <value>Dimanche</value>
  </data>
  <data name="WeekStart_Monday" xml:space="preserve">
    <value>Lundi</value>
  </data>
  <data name="InitialDate_Name" xml:space="preserve">
    <value>S’ouvre le</value>
  </data>
  <data name="InitialDate_Desc" xml:space="preserve">
    <value>Le jour auquel le calendrier s’ouvre, au format aaaa-MM-jj. Laissez vide pour aujourd’hui.</value>
  </data>
  <data name="AllowMove_Name" xml:space="preserve">
    <value>Autoriser le déplacement</value>
  </data>
  <data name="AllowMove_Desc" xml:space="preserve">
    <value>Si un événement peut être glissé, ou déplacé depuis son menu, vers un autre jour. Nécessite un hôte capable d’écrire.</value>
  </data>
  <data name="AllowCreate_Name" xml:space="preserve">
    <value>Autoriser la création</value>
  </data>
  <data name="AllowCreate_Desc" xml:space="preserve">
    <value>Si chaque jour propose un + qui ouvre le formulaire de création rapide avec ce jour prérempli. Applications pilotées par modèle uniquement.</value>
  </data>
  <data name="OpenOnEventClick_Name" xml:space="preserve">
    <value>Ouvrir au clic</value>
  </data>
  <data name="OpenOnEventClick_Desc" xml:space="preserve">
    <value>Si cliquer sur un événement ouvre son enregistrement.</value>
  </data>
  <data name="ShowTimes_Name" xml:space="preserve">
    <value>Afficher les heures</value>
  </data>
  <data name="ShowTimes_Desc" xml:space="preserve">
    <value>Si un événement horodaté affiche son heure de début devant son titre.</value>
  </data>
  <data name="PageSize_Name" xml:space="preserve">
    <value>Événements par chargement</value>
  </data>
  <data name="PageSize_Desc" xml:space="preserve">
    <value>Combien d’événements sont chargés à la fois. Laissez vide pour la taille de page de l’hôte. Un mois plus rempli affiche Charger plus.</value>
  </data>
  <data name="SelectedDate_Name" xml:space="preserve">
    <value>Date sélectionnée</value>
  </data>
  <data name="SelectedDate_Desc" xml:space="preserve">
    <value>Le dernier jour cliqué ou ciblé par un déplacement, au format aaaa-MM-jj.</value>
  </data>
  <data name="MovedRecordId_Name" xml:space="preserve">
    <value>Enregistrement déplacé</value>
  </data>
  <data name="MovedRecordId_Desc" xml:space="preserve">
