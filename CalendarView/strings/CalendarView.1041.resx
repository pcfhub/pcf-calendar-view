  </data>
  <data name="CalendarView_StartLater" xml:space="preserve">
    <value>開始を 1 日後へ</value>
  </data>
  <data name="CalendarView_EndEarlier" xml:space="preserve">
    <value>終了を 1 日前へ</value>
  </data>
  <data name="CalendarView_EndLater" xml:space="preserve">
    <value>終了を 1 日後へ</value>
  </data>
  <data name="CalendarView_New" xml:space="preserve">
    <value>新規</value>
  </data>
  <data name="CalendarView_TimelineEvents" xml:space="preserve">
